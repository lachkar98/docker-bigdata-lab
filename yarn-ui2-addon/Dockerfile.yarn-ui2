# Build only the official UI module; do not replace Hadoop server libraries.
FROM eclipse-temurin:8-jdk-jammy AS ui-builder
USER root
RUN apt-get update && apt-get install -y --no-install-recommends maven curl ca-certificates git python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN set -eux; \
 base=https://archive.apache.org/dist/hadoop/common/hadoop-3.4.3; \
 curl -fSL --retry 3 "$base/hadoop-3.4.3-src.tar.gz.sha512" -o source.sha512; \
 expected="$(grep -Eo '[[:xdigit:]]{128}' source.sha512)"; test "${#expected}" = 128; \
 curl -fSL --retry 3 "$base/hadoop-3.4.3-src.tar.gz" -o source.tgz; \
 echo "$expected  source.tgz" | sha512sum -c -; \
 tar -xzf source.tgz --strip-components=1; rm source.tgz source.sha512
# Maven's frontend plugin installs the Node/Yarn versions pinned by Hadoop.
RUN mvn -B -pl hadoop-yarn-project/hadoop-yarn/hadoop-yarn-ui \
 -Pyarn-ui -DskipTests -Drat.skip=true -Dcheckstyle.skip package
RUN test -s /build/hadoop-yarn-project/hadoop-yarn/hadoop-yarn-ui/target/hadoop-yarn-ui-3.4.3.war

FROM bigdata-hadoop:3.4.3-java8
USER root
COPY --from=ui-builder /build/hadoop-yarn-project/hadoop-yarn/hadoop-yarn-ui/target/hadoop-yarn-ui-3.4.3.war /opt/yarn-ui2/hadoop-yarn-ui-3.4.3.war
RUN python3 -c 'import xml.etree.ElementTree as E; p="/opt/hadoop/etc/hadoop/yarn-site.xml"; t=E.parse(p); r=t.getroot(); values={"yarn.webapp.ui2.enable":"true","yarn.webapp.ui2.war-file-path":"/opt/yarn-ui2/hadoop-yarn-ui-3.4.3.war"}; [(r.remove(q)) for q in list(r) if q.findtext("name") in values]; [(E.SubElement(q,"name").__setattr__("text",k),E.SubElement(q,"value").__setattr__("text",v)) for k,v in values.items() for q in [E.SubElement(r,"property")]]; t.write(p)'
USER hadoop
